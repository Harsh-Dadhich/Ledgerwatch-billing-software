# Copy this file to .env and fill in real values. Never commit .env itself.

MONGO_URI=mongodb://localhost:27017/ledgerwatch
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Set to "production" to enable secure cookie flags
ENVIRONMENT=development
